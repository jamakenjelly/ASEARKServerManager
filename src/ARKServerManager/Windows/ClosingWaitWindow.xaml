<Window x:Class="ServerManagerTool.ClosingWaitWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="420" ResizeMode="NoResize" SizeToContent="Height" WindowStyle="SingleBorderWindow" WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Icon="../Art/favicon.ico" Title="{DynamicResource ClosingWaitWindow_Title}">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="..\Globalization\en-US\en-US.xaml"/>
                <ResourceDictionary Source="..\Styles\Default.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <Grid Background="{StaticResource BeigeGradient}" Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" TextWrapping="Wrap" Margin="0,0,0,8" Text="{DynamicResource ClosingWaitWindow_Message}"/>

        <ListBox Grid.Row="1" Margin="0,0,0,8" MaxHeight="150" ItemsSource="{Binding ActiveProfileNames}"/>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Margin="0,0,5,0" Padding="8,2" Content="{DynamicResource ClosingWaitWindow_CloseNowButton}" Click="CloseNow_Click"/>
            <Button Padding="8,2" Content="{DynamicResource ClosingWaitWindow_CancelButton}" Click="Cancel_Click"/>
        </StackPanel>
    </Grid>
</Window>
