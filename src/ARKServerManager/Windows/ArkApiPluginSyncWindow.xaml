<Window x:Class="ServerManagerTool.ArkApiPluginSyncWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        MinWidth="600" MinHeight="640" Width="760" Height="700" WindowStyle="ToolWindow" WindowStartupLocation="CenterOwner" ShowInTaskbar="False" ResizeMode="CanResize"
        Loaded="Window_Loaded"
        Icon="../Art/favicon.ico" Title="{DynamicResource ArkApiPluginSyncWindow_Title}"
        FocusManager.FocusedElement="{Binding ElementName=CloseButton}">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="..\Globalization\en-US\en-US.xaml"/>
                <ResourceDictionary Source="..\Styles\Default.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Background="{StaticResource GradientBackground}">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Margin="5,5,5,0" Text="{DynamicResource ArkApiPluginSyncWindow_InformationLabel}" TextWrapping="Wrap" VerticalAlignment="Center" FontWeight="Bold"/>

            <StackPanel Grid.Row="1" Grid.Column="0" Margin="5,10,5,0">
                <TextBlock Text="{DynamicResource ArkApiPluginSyncWindow_PluginLabel}" FontWeight="Bold" Margin="0,0,0,2"/>
                <ComboBox x:Name="PluginComboBox" ItemsSource="{Binding AvailablePlugins}" SelectionChanged="PluginComboBox_SelectionChanged" IsEditable="False"/>
                <Button Content="{DynamicResource ArkApiPluginSyncWindow_RemovePluginButtonLabel}" Padding="6,1" Margin="0,4,0,0" HorizontalAlignment="Left" Click="RemovePlugin_Click" ToolTip="{DynamicResource ArkApiPluginSyncWindow_RemovePluginButtonTooltip}"/>

                <TextBlock Text="{DynamicResource ArkApiPluginSyncWindow_AddPluginFolderLabel}" FontWeight="Bold" Margin="0,14,0,2"/>
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="{DynamicResource ArkApiPluginSyncWindow_BrowseButtonLabel}" Margin="5,0,0,0" Padding="6,1" Click="BrowseAddPluginFolder_Click" ToolTip="{DynamicResource ArkApiPluginSyncWindow_BrowseAddPluginFolderTooltip}"/>
                    <TextBox Text="{Binding AddPluginSourceFolder, Mode=OneWay}" IsReadOnly="True" VerticalContentAlignment="Center"/>
                </DockPanel>
                <Button Content="{DynamicResource ArkApiPluginSyncWindow_AddPluginButtonLabel}" Padding="6,1" Margin="0,4,0,0" HorizontalAlignment="Left" Click="AddPlugin_Click" ToolTip="{DynamicResource ArkApiPluginSyncWindow_AddPluginButtonTooltip}"/>
            </StackPanel>

            <StackPanel Grid.Row="2" Grid.Column="0" Margin="5,10,5,0">
                <TextBlock Text="{DynamicResource ArkApiPluginSyncWindow_ConfigFileLabel}" FontWeight="Bold" Margin="0,0,0,2"/>
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="{DynamicResource ArkApiPluginSyncWindow_BrowseButtonLabel}" Margin="5,0,0,0" Padding="6,1" Click="BrowseConfigFile_Click" ToolTip="{DynamicResource ArkApiPluginSyncWindow_BrowseButtonTooltip}"/>
                    <ComboBox x:Name="ConfigFileComboBox" ItemsSource="{Binding AvailableConfigFiles}" IsEditable="False"/>
                </DockPanel>
            </StackPanel>

            <TextBlock Grid.Row="3" Grid.Column="0" Margin="5,10,5,0" Text="{DynamicResource ArkApiPluginSyncWindow_NoFilesFoundLabel}" TextWrapping="Wrap" Foreground="{DynamicResource WarningMessage}"
                       Visibility="{Binding HasNoConfigFiles, Converter={StaticResource BooleanToVisibilityConverter}}"/>

            <ListView Grid.Row="1" Grid.RowSpan="4" Grid.Column="1" Margin="5,5,5,0" ItemsSource="{Binding SyncProfiles}" HorizontalContentAlignment="Stretch">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Width="Auto">
                            <GridViewColumnHeader>
                                <TextBlock Text="{DynamicResource ProfileSyncWindow_SelectedColumnLabel}" />
                            </GridViewColumnHeader>
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding Selected}" HorizontalAlignment="Center"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Width="230" DisplayMemberBinding="{Binding ProfileName}">
                            <GridViewColumnHeader HorizontalContentAlignment="Stretch" HorizontalAlignment="Stretch" Padding="5,0,0,0">
                                <TextBlock Text="{DynamicResource ProfileSyncWindow_ProfileNameColumnLabel}" />
                            </GridViewColumnHeader>
                        </GridViewColumn>
                    </GridView>
                </ListView.View>

                <ListView.ItemContainerStyle>
                    <Style TargetType="{x:Type ListViewItem}" >
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Background" Value="White" />
                        <Setter Property="Height" Value="20" />
                    </Style>
                </ListView.ItemContainerStyle>
            </ListView>

            <DockPanel Grid.Row="5" Grid.Column="1">
                <Button DockPanel.Dock="Left" Content="{DynamicResource ProfileSyncWindow_SelectAllButtonLabel}" Margin="5" MinWidth="75" HorizontalAlignment="Left" Click="ProfileSelectAll_Click"/>
                <Button DockPanel.Dock="Left" Content="{DynamicResource ProfileSyncWindow_UnselectAllButtonLabel}" Margin="5" MinWidth="75" HorizontalAlignment="Left" Click="ProfileUnselectAll_Click"/>
                <Button DockPanel.Dock="Left" Content="{DynamicResource ProfileSyncWindow_SelectAllPVEButtonLabel}" Margin="5" MinWidth="75" HorizontalAlignment="Left" Click="ProfileSelectAllPVE_Click" ToolTip="{DynamicResource ProfileSyncWindow_SelectAllPVEButtonTooltip}"/>
                <Button DockPanel.Dock="Left" Content="{DynamicResource ProfileSyncWindow_SelectAllPVPButtonLabel}" Margin="5" MinWidth="75" HorizontalAlignment="Left" Click="ProfileSelectAllPVP_Click" ToolTip="{DynamicResource ProfileSyncWindow_SelectAllPVPButtonTooltip}"/>
            </DockPanel>

            <DockPanel Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="2">
                <Button x:Name="CloseButton" DockPanel.Dock="Right" Content="{DynamicResource ProfileSyncWindow_CloseButtonLabel}" Margin="5" MinWidth="75" HorizontalAlignment="Right" IsCancel="True"/>
                <Button DockPanel.Dock="Right" Content="{DynamicResource ProfileSyncWindow_ProcessButtonLabel}" Margin="5" MinWidth="75" HorizontalAlignment="Right" Click="Process_Click"/>
            </DockPanel>
        </Grid>

        <!-- It's important that this is in the end of the XAML as it needs to be on top of everything else! -->
        <Grid x:Name="OverlayGrid" Visibility="Collapsed" DockPanel.Dock="Top" >
            <Grid Background="Black" Opacity="0.5"/>
            <Border MinWidth="250" Background="Orange" BorderBrush="Black" BorderThickness="1" CornerRadius="0,0,0,0" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition/>
                    </Grid.RowDefinitions>

                    <Label x:Name="OverlayProfile" Grid.Row="0" Margin="5" FontWeight="Bold" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
