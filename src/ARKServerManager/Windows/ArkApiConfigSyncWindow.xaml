<Window x:Class="ServerManagerTool.ArkApiConfigSyncWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        MinWidth="500" MinHeight="450" Width="560" Height="620" WindowStyle="ToolWindow" WindowStartupLocation="CenterOwner" ShowInTaskbar="False" ResizeMode="CanResize"
        Loaded="Window_Loaded"
        Icon="../Art/favicon.ico" Title="{DynamicResource ArkApiConfigSyncWindow_Title}">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="..\Globalization\en-US\en-US.xaml"/>
                <ResourceDictionary Source="..\Styles\Default.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Background="{DynamicResource GradientBackground}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Margin="5" Text="{DynamicResource ArkApiConfigSyncWindow_InformationLabel}" TextWrapping="Wrap" FontWeight="Bold"/>

        <Grid Grid.Row="1" Margin="5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="1.6*"/>
            </Grid.ColumnDefinitions>

            <DockPanel Grid.Column="0" Margin="0,0,5,0">
                <TextBlock DockPanel.Dock="Top" Text="{DynamicResource ArkApiConfigSyncWindow_PluginsLabel}" FontWeight="Bold" Margin="0,0,0,2"/>
                <ListBox x:Name="PluginListBox" ItemsSource="{Binding AvailablePlugins}" SelectionChanged="PluginListBox_SelectionChanged"/>
            </DockPanel>

            <DockPanel Grid.Column="1" Margin="5,0,0,0">
                <TextBlock DockPanel.Dock="Top" Text="{DynamicResource ArkApiConfigSyncWindow_FilesLabel}" FontWeight="Bold" Margin="0,0,0,2"/>
                <ListBox x:Name="FileListBox" ItemsSource="{Binding PluginFiles}" MouseDoubleClick="FileListBox_MouseDoubleClick"/>
            </DockPanel>
        </Grid>

        <DockPanel Grid.Row="2">
            <Button DockPanel.Dock="Right" Content="{DynamicResource ProfileSyncWindow_CloseButtonLabel}" Margin="5" MinWidth="75" IsCancel="True"/>
            <Button DockPanel.Dock="Right" Content="{DynamicResource ArkApiConfigSyncWindow_EditButtonLabel}" Margin="5" MinWidth="75" Click="Edit_Click"/>
            <Grid/>
        </DockPanel>
    </Grid>
</Window>
